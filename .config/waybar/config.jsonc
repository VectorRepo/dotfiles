{
  "reload_style_on_change": true,
  "exclusive": true,
  "position": "top",
  "layer": "top",
  "spacing": 0,
  "height": 30,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-right": 0,
  "margin-left": 0,
  "modules-left": [
    "group/left1",
    "group/left2",
    "group/left3"
  ],

  "group/left1": {
    "orientation": "inherit",
    "modules": [
      "custom/launcher"
    ]
  },

  "custom/launcher": {
    "format": "catchy",
    "on-click": "wofi --show drun",
    "tooltip": false
  },

  "group/left2": {
    "orientation": "inherit",
    "modules": [
      "niri/workspaces",
    ]
  },

  "group/left3": {
    "orientation": "inherit",
    "modules": [
      "custom/swaync"
    ]
  },

  // Notification ikon a SwayNotificationCenterhez (swaync). Bal klikk
  // nyitja/zárja a notification centert, jobb klikk toggle-olja a
  // Do Not Disturb módot. Ehhez a swaync daemonnak futnia kell
  // (exec swaync a niri/hyprland configban), és a swaync-client
  // binárisnak elérhetőnek kell lennie a PATH-on.
  "custom/swaync": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#f53c3c'>󱅫</span>",
      "none": "󰂜",
      "dnd-notification": "<span foreground='#f53c3c'>󰂠</span>",
      "dnd-none": "󰪓",
      "inhibited-notification": "<span foreground='#f53c3c'>󰂛</span>",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "<span foreground='#f53c3c'>󰂛</span>",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "modules-center": [
    "clock"
    // Az omarchy-specifikus indikátorok (idle-indicator, notification-silencing,
    // voxtype, screenrecording-indicator, update) ide voltak beépítve, de ezek
    // a $OMARCHY_PATH-ban lévő saját scripteket hívták, ezért kivettem őket.
  ],

  "modules-right": ["group/right1", "group/right", "group/right2"],

  "group/right1": {
    "orientation": "inherit",
    "modules": ["tray"]
  },

  "group/right": {
    "orientation": "inherit",
    "modules": [
      "pulseaudio",
      "memory",
      "cpu"
    ]
  },

  "group/right2": {
    "orientation": "inherit",
    "modules": ["custom/power"]
  },

  // Power gomb - megnyitja a Wofi alapú power menüt (zárolás,
  // kijelentkezés, felfüggesztés, újraindítás, leállítás).
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "bash $HOME/.config/wofi/scripts/powermenu.sh"
  },

  // niri saját waybar modulja (>= waybar verzió, ami tartalmazza a niri
  // támogatást; ha nagyon régi waybar van telepítve és a modul "unknown
  // module" hibát ad, frissítsd a waybart).
  // Kattintással alapból lehet workspace-t váltani (disable-click: false).
  // A "persistent-workspaces" hyprland-specifikus volt, niri alatt a fix
  // munkaterületeket magában a niri config.kdl-ben nevezed el (workspace "1" stb.).
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "urgent": "●",
      "focused": "●",
      "active": "●",
      "default": "○"
    }
  },

  // Csak Arch/pacman alapú disztribúciókon működik, mert a
  // waybar-module-pacman-updates külső binárisra épül.
  // "custom/updatespacman": {
  //   "format": "{}{icon}",
  //   "return-type": "json",
  //   "format-icons": {
  //     "has-updates": " 󰏖",
  //     "updated": ""
  //   },
  //   "exec-if": "which waybar-module-pacman-updates",
  //   "exec": "waybar-module-pacman-updates --no-zero-output"
  // },

  "cpu": {
    "interval": 5,
    "format": "cpu {usage}%"
  },
  "memory": {
    "interval": 5,
    "format": "mem {used:0.1f}G"
  },
  "clock": {
    "locale": "en_US.UTF-8",
    "format": "{:%a %d ｜ %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    // Generikus PulseAudio/PipeWire mixer GUI
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    }
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },
}
