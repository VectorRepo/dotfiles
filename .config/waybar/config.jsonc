{
  "reload_style_on_change": true,
  "exclusive": true,
  "position": "top",
  "spacing": 0,
  "height": 30,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-right": 0,
  "margin-left": 0,
  "modules-left": [
    "group/left1",
    "group/left2",
    "group/left4"
  ],

  "group/left1": {
    "orientation": "inherit",
    "modules": [
      "custom/launcher"
    ]
  },

  "custom/launcher": {
    "format": "catchy",
    "on-click": "wofi --show drun",
    "tooltip": false
  },

  "group/left2": {
    "orientation": "inherit",
    "modules": [
      "niri/workspaces",
    ]
  },

  "group/left4": {
    "orientation": "inherit",
    "modules": ["mpris"]
  },

  "modules-center": [
    "clock"
    // Az omarchy-specifikus indikátorok (idle-indicator, notification-silencing,
    // voxtype, screenrecording-indicator, update) ide voltak beépítve, de ezek
    // a $OMARCHY_PATH-ban lévő saját scripteket hívták, ezért kivettem őket.
  ],

  "modules-right": ["group/right1", "group/right"],

  "group/right1": {
    "orientation": "inherit",
    "modules": ["tray"]
  },

  "group/right": {
    "orientation": "inherit",
    "modules": [
      "pulseaudio",
      "memory",
      "cpu",
      "battery"
    ]
  },

  // niri saját waybar modulja (>= waybar verzió, ami tartalmazza a niri
  // támogatást; ha nagyon régi waybar van telepítve és a modul "unknown
  // module" hibát ad, frissítsd a waybart).
  // Kattintással alapból lehet workspace-t váltani (disable-click: false).
  // A "persistent-workspaces" hyprland-specifikus volt, niri alatt a fix
  // munkaterületeket magában a niri config.kdl-ben nevezed el (workspace "1" stb.).
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "urgent": "●",
      "focused": "●",
      "active": "●",
      "default": "○"
    }
  },

  // Csak Arch/pacman alapú disztribúciókon működik, mert a
  // waybar-module-pacman-updates külső binárisra épül.
  // "custom/updatespacman": {
  //   "format": "{}{icon}",
  //   "return-type": "json",
  //   "format-icons": {
  //     "has-updates": " 󰏖",
  //     "updated": ""
  //   },
  //   "exec-if": "which waybar-module-pacman-updates",
  //   "exec": "waybar-module-pacman-updates --no-zero-output"
  // },

  "cpu": {
    "interval": 5,
    "format": "cpu {usage}%",
    // Cseréld a saját terminál emulátorodra és TUI-dra, pl.: "foot -e btop"
    "on-click": "your-terminal -e btop"
  },
  "memory": {
    "interval": 5,
    "format": "mem {used:0.1f}G",
    "on-click": "your-terminal -e btop"
  },
  "clock": {
    "locale": "en_US.UTF-8",
    "format": "{:%a %d ｜ %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    // Generikus PulseAudio/PipeWire mixer GUI
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    }
  },
  "battery": {
    "format": "bat {capacity}%",
    "format-discharging": "bat {capacity}%",
    "format-charging": "bat {capacity}%",
    "format-plugged": "bat_p {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "bat_f {capacity}%",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%\n {timeTo}",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%\n {timeTo}",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  "mpris": {
    "format": " {artist} - {title}",
    "format-paused": "<span color='grey'>{status_icon}  {title}</span>",
    "max-length": 75,
    "player-icons": {
      "default": "⏸",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "󰝛"
    },
    "ignored-players": ["firefox", "chromium", "brave"]
  },
}
