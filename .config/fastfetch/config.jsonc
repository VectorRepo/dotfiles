{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "width": 30,
        "height": 15,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " → "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": " OS"
        },
        {
            "type": "kernel",
            "key": " Kernel"
        },
        {
            "type": "packages",
            "key": " Packages"
        },
        {
            "type": "shell",
            "key": " Shell"
        },
        {
            "type": "de",
            "key": " DE"
        },
        {
            "type": "wm",
            "key": " WM"
        },
        {
            "type": "terminal",
            "key": " Terminal"
        },
        "break",
        {
            "type": "cpu",
            "key": "󰻠 CPU"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery"
        },
        "break",
        {
            "type": "localip",
            "key": "󰩟 Local IP"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime"
        },
        {
            "type": "datetime",
            "key": "󰃭 Date"
        }
    ]
}
